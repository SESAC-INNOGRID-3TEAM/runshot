# ===== 앱 서버 공통 =====
APP_ENV=local
# 실배포 전 반드시 교체할 것 (로컬 테스트용 값을 그대로 쓰면 안 됨)
SECRET_KEY=change-this-before-real-deploy

# ===== DB 서버 연결 =====
# 로컬 1대 PC 시뮬레이션: host.docker.internal (Mac Docker Desktop 전용, 컨테이너->호스트)
# 실제 2대 서버 배포: 서버 B(DB 서버)의 실제 IP/도메인으로 교체
# (worker/api 모두 이 값을 씀 — 서버 A의 컨테이너에서 서버 B로 접속하는 경로)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=runshot
DB_USER=runshot
DB_PASSWORD=change-this-before-real-deploy

# ===== Redis (세션 / 캐시) =====
# DB_HOST와 동일한 규칙: 로컬은 host.docker.internal, 실배포는 서버 B 실제 IP
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_SESSION_TTL=3600

# ===== MinIO (S3 호환) =====
# DB_HOST와 동일한 규칙: 로컬은 host.docker.internal:9000, 실배포는 서버 B 실제 IP:9000
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=change-this-before-real-deploy
MINIO_SECRET_KEY=change-this-before-real-deploy
MINIO_BUCKET_RAW=runshot-raw
MINIO_BUCKET_DERIVED=runshot-derived
MINIO_BUCKET_COVERS=runshot-covers
MINIO_PRESIGNED_EXPIRY=900

# ===== RabbitMQ =====
# worker/nginx/api와 같은 서버 A 안의 컨테이너라 로컬/실배포 상관없이
# 항상 서비스 이름 그대로 사용(서버 IP로 바꾸지 않음)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=runshot
RABBITMQ_PASSWORD=change-this-before-real-deploy
RABBITMQ_OCR_QUEUE=ocr_queue
RABBITMQ_OCR_DLQ=ocr_dlq

# ===== JWT =====
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ===== OCR =====
# 도커 컨테이너 안(Debian, apt로 설치) 기준 경로. 컨테이너 없이 로컬 Mac에서
# 직접 테스트할 때는 `which tesseract` 결과(보통 /opt/homebrew/bin/tesseract)로 덮어써서 실행
TESSERACT_CMD=/usr/bin/tesseract
OCR_MIN_CONFIDENCE=0.6
BIB_MIN_DIGITS=2
BIB_MAX_DIGITS=5
