# ===== 앱 서버 공통 =====
APP_ENV=local
SECRET_KEY=

# ===== DB 서버 연결 =====
DB_HOST=
DB_PORT=3306
DB_NAME=runshot
DB_USER=
DB_PASSWORD=

# ===== Redis (세션 / 캐시) =====
REDIS_HOST=
REDIS_PORT=6379
REDIS_SESSION_TTL=3600

# ===== MinIO (S3 호환) =====
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_RAW=runshot-raw
MINIO_BUCKET_DERIVED=runshot-derived
MINIO_BUCKET_COVERS=runshot-covers
MINIO_PRESIGNED_EXPIRY=900

# ===== RabbitMQ =====
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_OCR_QUEUE=ocr_queue
RABBITMQ_OCR_DLQ=ocr_dlq

# ===== JWT =====
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ===== OCR =====
TESSERACT_CMD=
OCR_MIN_CONFIDENCE=0.6
BIB_MIN_DIGITS=2
BIB_MAX_DIGITS=5
